<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive OAuth tokens & credentials from cloud backups -->
        <exclude domain="sharedpref" path="fitforge_chatgpt_secure_prefs.xml" />
        <exclude domain="sharedpref" path="fitforge_chatgpt_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fitforge_chatgpt_secure_prefs.xml" />
        <exclude domain="sharedpref" path="fitforge_chatgpt_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
